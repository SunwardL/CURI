{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CURI",
  "version": "0.1.0",
  "identifier": "com.sunward.curi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CURI",
        "width": 1320,
        "height": 860,
        "minWidth": 920,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local Codex usage dashboard",
    "longDescription": "A local dashboard for Codex usage and relay reliability.",
    "externalBin": ["binaries/curi-backend"]
  }
}
